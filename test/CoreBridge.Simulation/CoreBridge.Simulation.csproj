<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Multipass-Simulator für Tests und cb-sim. Bewusst außerhalb von
    CoreBridge.Core: gehört nicht ins Produkt. Die CLI referenziert das
    Projekt nur im Debug-Build, damit cb-sim ihn über Bootstrap laden kann.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoreBridge.Core\CoreBridge.Core.csproj" />
  </ItemGroup>

</Project>
