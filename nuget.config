<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Lokaler Feed für TuiControls (Terminal.Gui.LivePrev): dotnet pack controls/TuiControls -c Release -o %USERPROFILE%\.nuget\local-feed -->
    <add key="local-feed" value="%USERPROFILE%\.nuget\local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-feed">
      <package pattern="TuiControls" />
    </packageSource>
  </packageSourceMapping>
</configuration>
