<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.0" />
    <PackageReference Include="UnionTypes" Version="0.1.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!-- Vertrauter Signierschlüssel: Ressource statt Config, damit keine Datei ihren eigenen Schlüssel mitbringt. -->
  <ItemGroup>
    <EmbeddedResource Include="Authenticity\corebridge-signing.pub.asc" LogicalName="CoreBridge.Core.Authenticity.corebridge-signing.pub.asc" />
  </ItemGroup>

</Project>
