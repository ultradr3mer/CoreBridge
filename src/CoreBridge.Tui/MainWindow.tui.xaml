<Window x:Class="CoreBridge.Tui.MainWindow"
        xmlns="http://schemas.gui-cs.github.io/tui/2026/xaml"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="CoreBridge"
        Width="Dim.Fill()"
        Height="Dim.Fill()">

  <DropDownList x="1"
                     y="2"
                     x:Name="Command"
                     ItemsSource="{Binding CommandList}" />

  <Label X="2"
         Y="3"
         Text="Your name:" />

  <TextField x:Name="NameField"
             X="15"
             Y="3"
             Width="24"
             TextChanged="OnNameChanged" />

  <Label x:Name="GreetingLabel"
         X="2"
         Y="5"
         Text="Hello, Anonymous!" />

  <Button X="2"
          Y="7"
          Text="Greet"
          Accepting="OnGreetClicked" />

  <Button X="Pos.Right(Root) - 10"
          Y="Pos.Bottom(Root) - 3"
          Text="Exit"
          Accepting="OnExitClicked" />

</Window>
