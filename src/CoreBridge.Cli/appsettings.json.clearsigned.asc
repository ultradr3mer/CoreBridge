-----BEGIN PGP SIGNED MESSAGE-----
Hash: SHA256

{
  "DefaultTimeout": "30s",
  "DefaultTimeoutVmCreation": "120s",
  "Inits": {
    "DefaultRuntimeImage": "daily:26.10",
    "StoreRoot": "%LOCALAPPDATA%\\CoreBridge",
    "Components": {
      "claude": {
        "Script": "scripts/components/install-claude.sh",
        "InstallPath": "/usr/local/sbin/corebridge-install-claude",
        "Packages": [
          "bash",
          "ca-certificates",
          "curl",
          "sudo"
        ],
        "PackageUpdate": true,
        "PackageUpgrade": false,
        "InstallUser": "ubuntu"
      },
      "dotnet": {
        "Snap": "dotnet-sdk-100",
        "Classic": true,
        "Script": "scripts/components/install-dotnet.sh",
        "InstallPath": "/usr/local/sbin/corebridge-install-dotnet",
        "InstallUser": "ubuntu"
      },
      "git": {
        "Script": "scripts/components/install-git.sh",
        "InstallPath": "/usr/local/sbin/corebridge-install-git",
        "Packages": [
          "git"
        ],
        "PackageUpdate": true,
        "InstallUser": "ubuntu"
      },
      "opencode": {
        "Snap": "opencode",
        "Classic": true
      },
      "python": {
        "Script": "scripts/components/install-python.sh",
        "InstallPath": "/usr/local/sbin/corebridge-install-python",
        "Packages": [
          "bash",
          "ca-certificates",
          "curl",
          "sudo"
        ],
        "PackageUpdate": true,
        "InstallUser": "ubuntu"
      },
      "cline": {
        "Script": "scripts/components/install-cline.sh",
        "InstallPath": "/usr/local/sbin/corebridge-install-cline",
        "Packages": [
          "bash",
          "ca-certificates",
          "curl",
          "sudo",
          "nodejs",
          "npm"
        ],
        "PackageUpdate": true,
        "InstallUser": "ubuntu"
      }
    }
  }
}
