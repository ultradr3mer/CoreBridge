namespace CoreBridge.Cli;

public class EventFactory
{
    private static Stopwatch sw;

    public EventFactory(TimeSpan elapsed, string operationTimeout, string userTimeout)
    {
        this.sw = new Stopwatch() { elapsed };
        sw.Start();

        this.operationTimeout = TimeSpan.Parse(operationTimeout);
        this.userTimeout = TimeSpan.Parse(userTimeout);
    }

    public static CliEvent Std(string data) => new StdEvent(data);
    public static CliEvent Err(string data) => new ErrEvent(data);
    public static InteractionEvent<T> Interaction<T>(string message, string timeout) => new InteractionEvent<T>(message, timeout);

    public static ChoiceEvent<T> Choice<T>(string message, string timeout) => new ChoiceEvent<T>(message, timeout);

    public static CliEvent GetElapsed() => sw.Elapsed.ToString("hh\\:mm\\:ss\\.fff");

}


public abstract class CliEvent
{
    public CliEvent(TimeSpan elapsed)
    {
        this.EmissionTime = elapsed;
    }

    public TimeSpan EmissionTime { get; }

    public string Printable { get; }
}

public class StdEvent : CliEvent
{
    public StdEvent(string printable)
    {
        this.Printable = printable;
    }
}

public class ErrEvent : CliEvent
{
    public ErrEvent(string printable)
    {
        this.Printable = printable;
    }
}

public abstract class InteractionEvent<T> : StdEvent, Task<T>
{

    public InteractionEvent(string message, string timeout)
       : base(message)
    {
        tcs = new TaskCompletionSource<T>();
    }

    TaskCompletionSource<T> tcs;

    public async Task<T> GetAwaiter()
    {
        return tcs.Task;
    }

    protected void SetResult(T value)
    {
        this.tcs.SetResult(value);
    }

    public void SetCanceled()
    {
        this.tcs.SetCanceled();
    }
}

public class OptionDef : Attribute
{
    private readonly string[] patterns;
    private readonly string display;

    public OptionDef(string display, string pattern)
    {
        this.patterns = pattern.Split(",").ToArray();
        this.display = display;
    }

    public bool IsMatch(string input)
    {
        return this.patterns.Any(p => p.Equals(input, StringComparison.OrdinalIgnoreCase));
    }

    public static bool IsMatch<T>(string input) where T : Enum
    {
        return FromAttribute(option).IsMatch(input);
    }

    public static bool IsMatch<T>(string input, out OptionDef def) where T : Enum
    {
        var opt = Enum.GetValues(typeof(T)).Cast<T>().ToArray();
        return FromAttribute(option).IsMatch(input);
    }

    public static bool HasMatch<T>(string input, out OptionDef def, params T[] option) where T : Enum
    {
        def = null;
        var m = (from o in option
                 let attr = FromAttribute(o)
                 where attr.IsMatch(input)
                 select attr).GetEnumerator();

        if (m.MoveNext())
        {
            def = m.Current;
            return true;
        }

        def = null;
        return false;
    }

    private static OptionDef FromAttribute<T>(T option) where T : Enum
    {
        return (OptionDef)option.GetType().GetCustomAttributes(typeof(OptionDef), false).Single();
    }

    // private static OptionDef? GetAttributeOrNull<T>(T option) where T : Enum
    // {
    //     return option.GetType().GetCustomAttributes(typeof(OptionMatches), false).FirstOrDefault() as OptionMatches;
    // }

    public string GetPatterns(int count, bool compact) => compact ? string.Join(",", this.patterns.Take(count))
                                                                : (string.Join(", ", this.patterns.Take(count - 1)) + " or " + this.patterns.Last());

    public override string ToString()
    {
        return this.display;
    }
}

