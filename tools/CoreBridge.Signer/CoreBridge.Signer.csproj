<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deployment-Werkzeug: signiert Dateien für CoreBridge außerhalb der CLI (CI, abgetrennte
       .asc). Wird nicht mit ausgeliefert; das Signieren selbst (PgpFileSigner) liegt in Core. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoreBridge.Core\CoreBridge.Core.csproj" />
  </ItemGroup>

</Project>
