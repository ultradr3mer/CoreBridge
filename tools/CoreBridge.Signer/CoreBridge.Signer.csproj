<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deployment-Werkzeug: signiert Dateien für CoreBridge. Wird nicht mit ausgeliefert
       und von Core/Cli nicht referenziert — das Produkt prüft nur. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

</Project>
